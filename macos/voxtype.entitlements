<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the voxtype daemon binary (Voxtype.app's main executable
  and the standalone universal binary), signed with the hardened runtime.
  Without audio-input, the hardened runtime blocks the microphone outright
  and no TCC prompt appears. apple-events covers the osascript output path.
  Accessibility and Input Monitoring have no entitlement; they are TCC grants.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
